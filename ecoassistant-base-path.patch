diff --git a/deploy/cloud-b/README.md b/deploy/cloud-b/README.md
new file mode 100644
index 0000000..378095c
--- /dev/null
+++ b/deploy/cloud-b/README.md
@@ -0,0 +1,72 @@
+# Деплой на EcoAssistant (https://cloud-b.istu.edu/ecoassistant/)
+
+```
+браузер ─https─▶ cloud-b: location /ecoassistant/ { proxy_pass http://172.25.4.35/; }   (срезает префикс)
+        ─http──▶ системный nginx :80   (/etc/nginx/sites-enabled.d/ecoassistant.conf)
+        ───────▶ docker-nginx 127.0.0.1:8088   (nginx/nginx.http.conf)
+        ───────▶ backend / admin / core-api / max
+```
+
+Префикс срезается **один раз** — на cloud-b. Дальше всё работает от корня.
+Сервисы знают префикс только из `shared.env` и подставляют его в то, что уходит в браузер:
+
+| Переменная (shared.env) | Значение на этом сервере | Где используется |
+|---|---|---|
+| `BASE_PATH` | `/ecoassistant` | редиректы и ссылки админки, cookie сессии, `/docs` backend и core-api |
+| `PUBLIC_BASE_URL` | `https://cloud-b.istu.edu/ecoassistant` | ссылки на карты и фото, webhook MAX (`+ /max-webhook`) |
+| `BASE_URL_MAPS` | `https://cloud-b.istu.edu/ecoassistant/maps/` | ссылки на карты |
+
+Публичные адреса: админка `…/ecoassistant/admin/`, API `…/ecoassistant/search/…`,
+core-api `…/ecoassistant/core-api/docs`, webhook `…/ecoassistant/max-webhook`.
+
+## Первый запуск
+
+```bash
+# 0. Docker (один раз; после usermod перелогиниться)
+sudo systemctl enable --now docker
+sudo usermod -aG docker assistant
+
+cd /srv/DockerEcoBot
+git pull
+
+# 1. Конфиги
+cp shared.env.example shared.env
+cp db_custom/.env.example db_custom/.env
+cp salut_bot/.env.example salut_bot/.env
+cp AdminPanel/.env.example AdminPanel/.env
+cp EcoBotProject/DialogService/.env.example EcoBotProject/DialogService/.env
+cp dsapi/.env.example dsapi/.env
+touch images-extractor/.env
+echo 'COMPOSE_FILE=docker-compose.yml:docker-compose.cloudb.yml' > .env
+```
+
+В `shared.env` задать `BASE_PATH`, `PUBLIC_BASE_URL`, `BASE_URL_MAPS` (см. таблицу), `DB_PASSWORD`,
+`MAX_BOT_TOKEN`, `BOT_TOKEN`, LLM_*. Тот же пароль БД — в `db_custom/.env` (`POSTGRES_PASSWORD`)
+и в `AdminPanel/.env` (`DB_PASSWORD`). В `AdminPanel/.env` — `SESSION_SECRET_KEY`
+(`python3 -c "import secrets; print(secrets.token_hex(32))"`) и `ADMIN_PASSWORD` пароль первого входа.
+
+```bash
+# 2. Каталоги, модели, запуск
+mkdir -p data/postgres_data data/admin_db logs maps salut_bot/images salut_bot/embedding_models \
+         salut_bot/knowledge_base_scripts/Vector/faiss_index dsapi/local_models dsapi/logs dsapi/results
+bash scripts/download_models.sh
+docker compose up -d --build
+
+# 3. Наполнение БД (фото берём с боевого сервера, пока salut_bot/images пустая)
+IMPORT_IMAGES_BASE_URL=https://testecobot.ru bash scripts/init_db.sh
+
+# 4. Системный nginx
+sudo cp deploy/cloud-b/ecoassistant.conf /etc/nginx/sites-enabled.d/ecoassistant.conf
+sudo nginx -t && sudo systemctl reload nginx
+```
+
+## Проверка
+
+```bash
+curl -sI http://127.0.0.1/admin/ | grep -i location   # → location: /ecoassistant/admin/login
+curl -s  http://127.0.0.1/health                       # → {"status":"ok"}
+```
+Затем в браузере: https://cloud-b.istu.edu/ecoassistant/admin/
+
+После правки `shared.env` нужен `docker compose up -d` (пересоздание контейнеров),
+а не `restart`: `restart` не перечитывает env_file.
diff --git a/deploy/cloud-b/ecoassistant.conf b/deploy/cloud-b/ecoassistant.conf
new file mode 100644
index 0000000..2ef2648
--- /dev/null
+++ b/deploy/cloud-b/ecoassistant.conf
@@ -0,0 +1,56 @@
+# /etc/nginx/sites-enabled.d/ecoassistant.conf — системный nginx на сервере EcoAssistant.
+#
+# Внешний шлюз cloud-b:  location /ecoassistant/ { proxy_pass http://172.25.4.35/; }
+# Он уже срезал префикс, сюда приходят пути от корня (/admin/, /maps/..., /max-webhook).
+# Здесь префикс НЕ добавляем и НЕ срезаем — просто отдаём всё в docker-nginx проекта
+# (docker-compose.cloudb.yml публикует его на 127.0.0.1:8088).
+#
+# Установка:
+#   sudo cp /srv/DockerEcoBot/deploy/cloud-b/ecoassistant.conf /etc/nginx/sites-enabled.d/ecoassistant.conf
+#   sudo nginx -t && sudo systemctl reload nginx
+# Других server-блоков на :80 в sites-enabled.d/ быть не должно (иначе запросы уйдут не сюда).
+
+# Шлюз завершает HTTPS. Если он прислал X-Forwarded-Proto — передаём его,
+# иначе считаем https: снаружи приложение доступно только через https-шлюз.
+map $http_x_forwarded_proto $ecoassistant_proto {
+    default $http_x_forwarded_proto;
+    ""      https;
+}
+
+upstream ecoassistant_docker {
+    server 127.0.0.1:8088;
+    keepalive 16;
+}
+
+server {
+    listen 80;
+    server_name _;
+
+    # Загрузка фото/аудио через админку (у docker-nginx тот же лимит)
+    client_max_body_size 10M;
+
+    location / {
+        proxy_pass http://ecoassistant_docker;
+        proxy_http_version 1.1;
+
+        # Host оставляем как прислал шлюз (172.25.4.35): тогда абсолютные редиректы
+        # вида http://172.25.4.35/... шлюз сам перепишет в /ecoassistant/... (proxy_redirect default)
+        proxy_set_header Host              $host;
+        proxy_set_header X-Real-IP         $remote_addr;
+        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $ecoassistant_proto;
+
+        # WebSocket (сейчас не используется, но заголовки не мешают)
+        proxy_set_header Upgrade    $http_upgrade;
+        proxy_set_header Connection $ecoassistant_connection;
+
+        # Поиск/LLM и тесты в админке отвечают долго
+        proxy_read_timeout 180s;
+        proxy_send_timeout 180s;
+    }
+}
+
+map $http_upgrade $ecoassistant_connection {
+    default upgrade;
+    ""      "";
+}
diff --git a/docker-compose.cloudb.yml b/docker-compose.cloudb.yml
new file mode 100644
index 0000000..bf6544d
--- /dev/null
+++ b/docker-compose.cloudb.yml
@@ -0,0 +1,36 @@
+# =============================================================
+# Сервер EcoAssistant за шлюзом https://cloud-b.istu.edu/ecoassistant/
+#
+# Схема:  браузер ──https──▶ cloud-b (срезает /ecoassistant/) ──http──▶ 172.25.4.35:80
+#         хостовый nginx (:80, /etc/nginx/sites-enabled.d/ecoassistant.conf)
+#         ──▶ 127.0.0.1:8088 — nginx из этого compose (nginx/nginx.http.conf) ──▶ сервисы
+#
+# Подключение — одна строка в .env в корне репозитория (файл в .gitignore):
+#   COMPOSE_FILE=docker-compose.yml:docker-compose.cloudb.yml
+# после этого обычные `docker compose up -d`, `docker compose logs` и т.д.
+#
+# Префикс задаётся в shared.env: BASE_PATH=/ecoassistant,
+# PUBLIC_BASE_URL=https://cloud-b.istu.edu/ecoassistant
+# =============================================================
+services:
+  nginx:
+    # Порт 80 на хосте занят системным nginx — наш слушает только localhost
+    ports: !override
+      - "127.0.0.1:8088:80"
+    # TLS снимает cloud-b: берём HTTP-конфиг, сертификаты не нужны
+    volumes: !override
+      - ./nginx/nginx.http.conf:/etc/nginx/nginx.conf:ro
+      - /dev/null:/etc/nginx/conf.d/default.conf
+      - ./maps:/var/www/maps
+      - ./salut_bot/images:/var/www/images
+
+  # Фаервол на сервере выключен: всё, что опубликовано на 0.0.0.0, видно из сети
+  # университета. Сервисам наружу торчать незачем — ходят друг к другу по ecobot_net,
+  # снаружи только через nginx.
+  db:
+    ports: !reset []
+  max:
+    # webhook приходит через nginx: /ecoassistant/max-webhook → max:8080
+    ports: !reset []
+  stt-service:
+    ports: !reset []
