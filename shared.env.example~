# =============================================================
# shared.env — общая конфигурация для всех сервисов EcoBot
# Управляется через AdminPanel → Настройки
# Загружается: backend, core-api, gigachat, admin
#
# ИНСТРУКЦИЯ:
#   Скопируйте этот файл: cp shared.env.example shared.env
#   Заполните реальными значениями
#   НИКОГДА не коммитьте shared.env в git
# =============================================================

# --- Публичные адреса ---
# BASE_PATH — префикс, под которым приложение опубликовано снаружи.
#   В корне домена (свой домен, локально): BASE_PATH=  (пусто)
#   За шлюзом cloud-b.istu.edu:           BASE_PATH=/ecoassistant
# Префикс срезает внешний шлюз — внутри nginx и сервисы работают от корня.
# BASE_PATH используется только для ссылок/редиректов в браузер (админка, /docs).
BASE_PATH=

# PUBLIC_BASE_URL и BASE_URL_MAPS — ПОЛНЫЕ публичные адреса, вместе с BASE_PATH:
#   cloud-b:  PUBLIC_BASE_URL=https://cloud-b.istu.edu/ecoassistant
#             BASE_URL_MAPS=https://cloud-b.istu.edu/ecoassistant/maps/
#   локально: PUBLIC_BASE_URL=http://localhost  BASE_URL_MAPS=http://localhost/maps/
# Из PUBLIC_BASE_URL строятся ссылки на карты/фото и webhook MAX-бота (PUBLIC_BASE_URL + /max-webhook).
PUBLIC_BASE_URL=http://localhost
BASE_URL_MAPS=http://localhost/maps/

# --- Внутренние адреса сервисов (Docker-сеть) ---
ECOBOT_API_BASE_URL=http://backend:8000

# --- PostgreSQL (хост задаётся через environment: в docker-compose) ---
DB_PORT=5432
DB_NAME=eco
DB_USER=postgres
DB_PASSWORD=changeme

# --- Redis (хост задаётся через environment: в docker-compose) ---
REDIS_PORT=6379
REDIS_DB=1

# --- LLM (Ollama / OpenAI-compatible) ---
LLM_PROVIDER=qwen
# Если Ollama на хост-машине (Docker Desktop): host.docker.internal
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:14b

# --- GigaChat (Sber) ---
GIGACHAT_CREDENTIALS=your_gigachat_base64_credentials
GIGACHAT_MODEL=GigaChat-2-Max
SBER_KEY_ENTERPRICE=your_sber_key_here

# --- Telegram-боты ---
BOT_TOKEN=your_telegram_bot_token
MAX_BOT_TOKEN=your_max_bot_token

# --- STAND API (внешний сервис достопримечательностей) ---
STAND_ENDPOINT=http://84.237.20.90:8084/scripts/sights_ii.jsp
STAND_SECRET_KEY=your_stand_secret_key
